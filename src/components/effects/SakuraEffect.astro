---
import { sakuraConfig } from "@/config";

// 硬开关：配置关闭时不渲染整个组件（包括开关依赖的脚本）
const sakuraEnabled = sakuraConfig?.enable === true;
---

{sakuraEnabled && (
	<script>
		import { initSakura, toggleSakura } from "@/utils/sakura-manager";
		import { sakuraConfig } from "@/config";

		// 页面加载完成后初始化樱花特效（根据 localStorage + 配置判断）
		const applySakura = () => {
			initSakura(sakuraConfig);
		};

		// 响应前台开关事件（由 DisplaySettings 派发）
		window.addEventListener("sakura-toggle", () => {
			toggleSakura(sakuraConfig);
		});

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", applySakura);
		} else {
			applySakura();
		}
	</script>
)}
