---

import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>

            <div class="mt-8 rounded-[var(--radius-large)] border border-neutral-200/60 dark:border-neutral-700/60 p-4">
                <h2 class="text-lg font-semibold">ESP32 局域网测试面板</h2>
                <p class="text-sm opacity-70 mt-1">填入 ESP32 的局域网地址，例如：192.168.1.88</p>

                <div class="mt-3 flex flex-wrap gap-2 items-center">
                    <input
                        id="esp32-host"
                        class="px-3 py-2 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent"
                        placeholder="192.168.1.88"
                        value="192.168.1.88"
                    />
                    <button id="esp32-status" class="px-3 py-2 rounded-md bg-black text-white dark:bg-white dark:text-black">读取状态</button>
                    <button id="esp32-toggle" class="px-3 py-2 rounded-md border border-neutral-300/60 dark:border-neutral-700/60">切换开关</button>
                    <button id="esp32-adc" class="px-3 py-2 rounded-md border border-neutral-300/60 dark:border-neutral-700/60">读取 ADC</button>
                </div>

                <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div class="rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4 bg-gradient-to-br from-white/60 to-white/10 dark:from-white/5 dark:to-white/0">
                        <div class="text-xs uppercase tracking-wider opacity-60">LED</div>
                        <div id="esp32-led" class="mt-1 text-2xl font-semibold">--</div>
                        <div class="mt-2 text-xs opacity-60">/toggle</div>
                    </div>
                    <div class="rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4 bg-gradient-to-br from-sky-50/80 to-sky-50/10 dark:from-sky-400/10 dark:to-sky-400/0">
                        <div class="text-xs uppercase tracking-wider opacity-60">ADC Raw</div>
                        <div id="esp32-adc-raw" class="mt-1 text-2xl font-semibold">--</div>
                        <div class="mt-2 text-xs opacity-60">0 ~ 4095</div>
                    </div>
                    <div class="rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4 bg-gradient-to-br from-emerald-50/80 to-emerald-50/10 dark:from-emerald-400/10 dark:to-emerald-400/0">
                        <div class="text-xs uppercase tracking-wider opacity-60">ADC Voltage</div>
                        <div id="esp32-adc-v" class="mt-1 text-2xl font-semibold">--</div>
                        <div class="mt-2 text-xs opacity-60">0.000 ~ 3.300V</div>
                    </div>
                </div>

                <div class="mt-5 rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4">
                    <div class="text-sm font-semibold">设置</div>
                    <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <label class="flex items-center gap-2 text-sm">
                            <input id="poll-enabled" type="checkbox" class="accent-black dark:accent-white" checked />
                            <span>启用轮询</span>
                        </label>
                        <label class="text-sm">
                            轮询间隔（ms）
                            <input id="poll-interval" type="number" min="500" step="100" value="2000"
                                class="mt-1 w-full px-3 py-2 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent" />
                        </label>
                        <label class="text-sm">
                            LED 引脚
                            <input id="led-pin" type="number" min="0" max="39" value="2"
                                class="mt-1 w-full px-3 py-2 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent" />
                        </label>
                        <label class="text-sm">
                            ADC 引脚
                            <input id="adc-pin" type="number" min="0" max="39" value="34"
                                class="mt-1 w-full px-3 py-2 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent" />
                        </label>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-2">
                        <button id="apply-settings" class="px-3 py-2 rounded-md bg-black text-white dark:bg-white dark:text-black">应用设置</button>
                        <button id="save-settings" class="px-3 py-2 rounded-md border border-neutral-300/60 dark:border-neutral-700/60">保存到本地</button>
                    </div>
                    <div class="mt-2 text-xs opacity-60">提示：引脚设置需要 ESP32 端支持 /config 接口。</div>
                </div>

                <div id="esp32-msg" class="mt-3 text-sm opacity-70"></div>
            </div>
        </div>
    </div>
</MainGridLayout>

<script>
    const msg = document.getElementById("esp32-msg");
    const hostInput = document.getElementById("esp32-host");
    const ledEl = document.getElementById("esp32-led");
    const adcRawEl = document.getElementById("esp32-adc-raw");
    const adcVEl = document.getElementById("esp32-adc-v");
    const pollEnabledEl = document.getElementById("poll-enabled");
    const pollIntervalEl = document.getElementById("poll-interval");
    const ledPinEl = document.getElementById("led-pin");
    const adcPinEl = document.getElementById("adc-pin");

    function buildUrl(path) {
        const host = hostInput.value.trim();
        if (!host) return null;
        return `http://${host}${path}`;
    }

    function setMsg(text) {
        msg.textContent = text;
    }

    function updateCards(data) {
        if (typeof data?.led === "boolean") {
            ledEl.textContent = data.led ? "ON" : "OFF";
            ledEl.className = `mt-1 text-2xl font-semibold ${data.led ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400"}`;
        }
        if (typeof data?.adc_raw === "number") {
            adcRawEl.textContent = String(data.adc_raw);
        }
        if (typeof data?.adc_v === "number") {
            adcVEl.textContent = `${data.adc_v.toFixed(3)} V`;
        }
    }

    async function request(path) {
        const url = buildUrl(path);
        if (!url) {
            setMsg("请先填写 ESP32 地址");
            return;
        }
        setMsg("请求中...");
        try {
            const res = await fetch(url, { method: "GET" });
            const text = await res.text();
            const maybeJson = text.trim().startsWith("{") ? JSON.parse(text) : null;
            if (maybeJson) updateCards(maybeJson);
            setMsg(`状态码: ${res.status}${maybeJson ? "" : ` | ${text}`}`);
        } catch (err) {
            setMsg("请求失败：" + err);
        }
    }

    document.getElementById("esp32-status").addEventListener("click", () => request("/status"));
    document.getElementById("esp32-toggle").addEventListener("click", () => request("/toggle"));
    document.getElementById("esp32-adc").addEventListener("click", () => request("/adc"));

    let pollTimer = null;
    function startPolling() {
        if (!pollEnabledEl.checked) return;
        const interval = Math.max(500, Number(pollIntervalEl.value) || 2000);
        if (pollTimer) clearInterval(pollTimer);
        pollTimer = setInterval(() => request("/status"), interval);
    }

    function stopPolling() {
        if (pollTimer) clearInterval(pollTimer);
        pollTimer = null;
    }

    function applySettings() {
        stopPolling();
        if (pollEnabledEl.checked) {
            startPolling();
        } else {
            setMsg("轮询已关闭");
        }
    }

    async function sendConfig() {
        const url = buildUrl(`/config?led_pin=${encodeURIComponent(ledPinEl.value)}&adc_pin=${encodeURIComponent(adcPinEl.value)}`);
        if (!url) {
            setMsg("请先填写 ESP32 地址");
            return;
        }
        setMsg("发送配置中...");
        try {
            const res = await fetch(url, { method: "GET" });
            const text = await res.text();
            setMsg(`配置结果: ${res.status} | ${text}`);
        } catch (err) {
            setMsg("配置失败：" + err);
        }
    }

    function saveSettings() {
        const payload = {
            pollEnabled: pollEnabledEl.checked,
            pollInterval: Number(pollIntervalEl.value) || 2000,
            ledPin: Number(ledPinEl.value) || 2,
            adcPin: Number(adcPinEl.value) || 34,
        };
        localStorage.setItem("esp32_panel_settings", JSON.stringify(payload));
        setMsg("已保存到本地");
    }

    function loadSettings() {
        try {
            const raw = localStorage.getItem("esp32_panel_settings");
            if (!raw) return;
            const data = JSON.parse(raw);
            if (typeof data.pollEnabled === "boolean") pollEnabledEl.checked = data.pollEnabled;
            if (typeof data.pollInterval === "number") pollIntervalEl.value = String(data.pollInterval);
            if (typeof data.ledPin === "number") ledPinEl.value = String(data.ledPin);
            if (typeof data.adcPin === "number") adcPinEl.value = String(data.adcPin);
        } catch {
            // ignore
        }
    }

    loadSettings();
    applySettings();

    document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
            stopPolling();
        } else {
            applySettings();
        }
    });

    pollEnabledEl.addEventListener("change", applySettings);
    pollIntervalEl.addEventListener("change", applySettings);
    document.getElementById("apply-settings").addEventListener("click", () => {
        applySettings();
        sendConfig();
    });
    document.getElementById("save-settings").addEventListener("click", saveSettings);
</script>