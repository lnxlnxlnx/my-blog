---

import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>

            <div class="mt-8 rounded-[var(--radius-large)] border border-neutral-200/60 dark:border-neutral-700/60 p-4">
                <h2 class="text-lg font-semibold">ESP32 局域网测试面板</h2>
                <p class="text-sm opacity-70 mt-1">填入 ESP32 的局域网地址，例如：192.168.1.88</p>

                <div class="mt-3 flex flex-wrap gap-2 items-center">
                    <input
                        id="esp32-host"
                        class="px-3 py-2 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent"
                        placeholder="192.168.1.88"
                        value="192.168.1.88"
                    />
                    <button id="esp32-status" class="px-3 py-2 rounded-md bg-black text-white dark:bg-white dark:text-black">读取状态</button>
                    <button id="esp32-toggle" class="px-3 py-2 rounded-md border border-neutral-300/60 dark:border-neutral-700/60">切换开关</button>
                    <button id="esp32-adc" class="px-3 py-2 rounded-md border border-neutral-300/60 dark:border-neutral-700/60">读取 ADC</button>
                </div>

                <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div class="rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4 bg-gradient-to-br from-white/60 to-white/10 dark:from-white/5 dark:to-white/0">
                        <div class="text-xs uppercase tracking-wider opacity-60">LED</div>
                        <div id="esp32-led" class="mt-1 text-2xl font-semibold">--</div>
                        <div class="mt-2 text-xs opacity-60">/toggle</div>
                    </div>
                    <div class="rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4 bg-gradient-to-br from-sky-50/80 to-sky-50/10 dark:from-sky-400/10 dark:to-sky-400/0">
                        <div class="text-xs uppercase tracking-wider opacity-60">ADC Raw</div>
                        <div id="esp32-adc-raw" class="mt-1 text-2xl font-semibold">--</div>
                        <div class="mt-2 text-xs opacity-60">0 ~ 4095</div>
                    </div>
                    <div class="rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4 bg-gradient-to-br from-emerald-50/80 to-emerald-50/10 dark:from-emerald-400/10 dark:to-emerald-400/0">
                        <div class="text-xs uppercase tracking-wider opacity-60">ADC Voltage</div>
                        <div id="esp32-adc-v" class="mt-1 text-2xl font-semibold">--</div>
                        <div class="mt-2 text-xs opacity-60">0.000 ~ 3.300V</div>
                    </div>
                </div>

                <div class="mt-4 rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="text-sm font-semibold">ADC 示波器</div>
                        <div class="text-xs opacity-60">实时波形（最近 200 点）</div>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-2 items-center text-sm">
                        <button id="scope-toggle" class="px-3 py-1.5 rounded-md bg-black text-white dark:bg-white dark:text-black">暂停</button>
                        <button id="scope-clear" class="px-3 py-1.5 rounded-md border border-neutral-300/60 dark:border-neutral-700/60">清空</button>
                        <label class="text-xs opacity-70">
                            采样来源
                            <select id="scope-source" class="ml-2 px-2 py-1 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent">
                                <option value="status">/status</option>
                                <option value="adc">/adc</option>
                            </select>
                        </label>
                        <label class="text-xs opacity-70">
                            采样间隔（ms）
                            <input id="scope-interval" type="number" min="100" step="50" value="300"
                                class="ml-2 w-24 px-2 py-1 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent" />
                        </label>
                        <label class="text-xs opacity-70">
                            平滑窗口
                            <input id="scope-smooth" type="number" min="1" max="21" step="2" value="5"
                                class="ml-2 w-20 px-2 py-1 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent" />
                        </label>
                        <label class="text-xs opacity-70">
                            拟合曲线
                            <input id="scope-fit" type="checkbox" class="ml-2 accent-black dark:accent-white" checked />
                        </label>
                    </div>
                    <canvas id="adc-scope" class="mt-3 w-full h-40 rounded-lg bg-gradient-to-br from-sky-50 via-white to-indigo-50"></canvas>
                </div>

                <div class="mt-4 rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="text-sm font-semibold">天气查询</div>
                        <div class="text-xs opacity-60">数据来源：Open-Meteo</div>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-2 items-center">
                        <input id="weather-city" class="px-3 py-2 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent" placeholder="城市名，例如：Shanghai" />
                        <input id="weather-lat" class="px-3 py-2 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent" placeholder="纬度" />
                        <input id="weather-lon" class="px-3 py-2 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent" placeholder="经度" />
                        <button id="weather-fetch" class="px-3 py-2 rounded-md bg-black text-white dark:bg-white dark:text-black">查询天气</button>
                        <button id="weather-send" class="px-3 py-2 rounded-md border border-neutral-300/60 dark:border-neutral-700/60">发送到 ESP32</button>
                    </div>

                    <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div class="rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4 bg-gradient-to-br from-amber-50/80 to-amber-50/10 dark:from-amber-400/10 dark:to-amber-400/0">
                            <div class="text-xs uppercase tracking-wider opacity-60">温度</div>
                            <div id="weather-temp" class="mt-1 text-2xl font-semibold">--</div>
                            <div class="mt-2 text-xs opacity-60">°C</div>
                        </div>
                        <div class="rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4 bg-gradient-to-br from-cyan-50/80 to-cyan-50/10 dark:from-cyan-400/10 dark:to-cyan-400/0">
                            <div class="text-xs uppercase tracking-wider opacity-60">风速</div>
                            <div id="weather-wind" class="mt-1 text-2xl font-semibold">--</div>
                            <div class="mt-2 text-xs opacity-60">km/h</div>
                        </div>
                        <div class="rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4 bg-gradient-to-br from-violet-50/80 to-violet-50/10 dark:from-violet-400/10 dark:to-violet-400/0">
                            <div class="text-xs uppercase tracking-wider opacity-60">天气代码</div>
                            <div id="weather-code" class="mt-1 text-2xl font-semibold">--</div>
                            <div id="weather-place" class="mt-2 text-xs opacity-60">--</div>
                        </div>
                    </div>

                    <div id="weather-msg" class="mt-3 text-sm opacity-70"></div>
                </div>

                <div class="mt-5 rounded-xl border border-neutral-200/60 dark:border-neutral-700/60 p-4">
                    <div class="text-sm font-semibold">设置</div>
                    <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <label class="flex items-center gap-2 text-sm">
                            <input id="poll-enabled" type="checkbox" class="accent-black dark:accent-white" checked />
                            <span>启用轮询</span>
                        </label>
                        <label class="text-sm">
                            轮询间隔（ms）
                            <input id="poll-interval" type="number" min="500" step="100" value="2000"
                                class="mt-1 w-full px-3 py-2 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent" />
                        </label>
                        <label class="text-sm">
                            LED 引脚
                            <input id="led-pin" type="number" min="0" max="39" value="2"
                                class="mt-1 w-full px-3 py-2 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent" />
                        </label>
                        <label class="text-sm">
                            ADC 引脚
                            <input id="adc-pin" type="number" min="0" max="39" value="34"
                                class="mt-1 w-full px-3 py-2 rounded-md border border-neutral-200/60 dark:border-neutral-700/60 bg-transparent" />
                        </label>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-2">
                        <button id="apply-settings" class="px-3 py-2 rounded-md bg-black text-white dark:bg-white dark:text-black">应用设置</button>
                        <button id="save-settings" class="px-3 py-2 rounded-md border border-neutral-300/60 dark:border-neutral-700/60">保存到本地</button>
                    </div>
                    <div class="mt-2 text-xs opacity-60">提示：引脚设置需要 ESP32 端支持 /config 接口。</div>
                </div>

                <div id="esp32-msg" class="mt-3 text-sm opacity-70"></div>
            </div>
        </div>
    </div>
</MainGridLayout>

<script>
    const msg = document.getElementById("esp32-msg");
    const hostInput = document.getElementById("esp32-host");
    const ledEl = document.getElementById("esp32-led");
    const adcRawEl = document.getElementById("esp32-adc-raw");
    const adcVEl = document.getElementById("esp32-adc-v");
    const pollEnabledEl = document.getElementById("poll-enabled");
    const pollIntervalEl = document.getElementById("poll-interval");
    const ledPinEl = document.getElementById("led-pin");
    const adcPinEl = document.getElementById("adc-pin");
    const scopeCanvas = document.getElementById("adc-scope");
    const scopeCtx = scopeCanvas.getContext("2d");
    const scopeBuffer = [];
    const scopeMax = 200;
    const scopeToggleBtn = document.getElementById("scope-toggle");
    const scopeClearBtn = document.getElementById("scope-clear");
    const scopeSourceEl = document.getElementById("scope-source");
    const scopeIntervalEl = document.getElementById("scope-interval");
    const scopeSmoothEl = document.getElementById("scope-smooth");
    const scopeFitEl = document.getElementById("scope-fit");
    let scopeCaptureEnabled = true;
    const weatherCityEl = document.getElementById("weather-city");
    const weatherLatEl = document.getElementById("weather-lat");
    const weatherLonEl = document.getElementById("weather-lon");
    const weatherTempEl = document.getElementById("weather-temp");
    const weatherWindEl = document.getElementById("weather-wind");
    const weatherCodeEl = document.getElementById("weather-code");
    const weatherPlaceEl = document.getElementById("weather-place");
    const weatherMsgEl = document.getElementById("weather-msg");
    let latestWeather = null;

    function buildUrl(path) {
        const host = hostInput.value.trim();
        if (!host) return null;
        return `http://${host}${path}`;
    }

    function setMsg(text) {
        msg.textContent = text;
    }

    function setWeatherMsg(text) {
        weatherMsgEl.textContent = text;
    }

    function updateCards(data) {
        if (typeof data?.led === "boolean") {
            ledEl.textContent = data.led ? "ON" : "OFF";
            ledEl.className = `mt-1 text-2xl font-semibold ${data.led ? "text-emerald-600 dark:text-emerald-400" : "text-rose-600 dark:text-rose-400"}`;
        }
        if (typeof data?.adc_raw === "number") {
            adcRawEl.textContent = String(data.adc_raw);
            if (scopeCaptureEnabled) pushScopePoint(data.adc_raw);
        }
        if (typeof data?.adc_v === "number") {
            adcVEl.textContent = `${data.adc_v.toFixed(3)} V`;
        }
    }

    function pushScopePoint(raw) {
        //if (raw === 0) return;
        scopeBuffer.push(raw);
        if (scopeBuffer.length > scopeMax) scopeBuffer.shift();
        drawScope();
    }

    function resizeCanvas() {
        const rect = scopeCanvas.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;
        scopeCanvas.width = Math.floor(rect.width * dpr);
        scopeCanvas.height = Math.floor(rect.height * dpr);
        scopeCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        drawScope();
    }

    function drawScope() {
        const w = scopeCanvas.width / (window.devicePixelRatio || 1);
        const h = scopeCanvas.height / (window.devicePixelRatio || 1);
        if (!w || !h) return;

        scopeCtx.clearRect(0, 0, w, h);

        // grid
        scopeCtx.strokeStyle = "rgba(0,0,0,0.06)";
        scopeCtx.lineWidth = 1;
        for (let x = 0; x <= w; x += w / 10) {
            scopeCtx.beginPath();
            scopeCtx.moveTo(x, 0);
            scopeCtx.lineTo(x, h);
            scopeCtx.stroke();
        }
        for (let y = 0; y <= h; y += h / 4) {
            scopeCtx.beginPath();
            scopeCtx.moveTo(0, y);
            scopeCtx.lineTo(w, y);
            scopeCtx.stroke();
        }

        // waveform
        if (scopeBuffer.length < 2) return;
        const smoothWindow = Math.max(1, Number(scopeSmoothEl.value) || 1);
        const preprocessed = preprocessBuffer(scopeBuffer, smoothWindow);
        const renderBuffer = scopeFitEl.checked ? preprocessed : preprocessed;
        scopeCtx.strokeStyle = "rgba(76, 120, 255, 0.9)";
        scopeCtx.lineWidth = 2;
        scopeCtx.beginPath();
        if (scopeFitEl.checked) {
            drawSpline(renderBuffer, w, h);
        } else {
            renderBuffer.forEach((v, i) => {
                const x = (i / (scopeMax - 1)) * w;
                const y = h - (v / 4095) * h;
                if (i === 0) scopeCtx.moveTo(x, y);
                else scopeCtx.lineTo(x, y);
            });
        }
        scopeCtx.stroke();

        // glow
        scopeCtx.strokeStyle = "rgba(76, 120, 255, 0.25)";
        scopeCtx.lineWidth = 6;
        scopeCtx.stroke();
    }

    function preprocessBuffer(buffer, windowSize) {
        const medianed = medianFilter(buffer, Math.max(1, Math.min(9, windowSize | 0)));
        return smoothBuffer(medianed, windowSize);
    }

    function smoothBuffer(buffer, windowSize) {
        const size = Math.max(1, windowSize | 0);
        if (size <= 1) return buffer;
        const half = Math.floor(size / 2);
        const out = new Array(buffer.length);
        for (let i = 0; i < buffer.length; i++) {
            let sum = 0;
            let count = 0;
            for (let k = i - half; k <= i + half; k++) {
                if (k >= 0 && k < buffer.length) {
                    sum += buffer[k];
                    count++;
                }
            }
            out[i] = sum / count;
        }
        return out;
    }

    function medianFilter(buffer, windowSize) {
        const size = Math.max(1, windowSize | 0);
        if (size <= 1) return buffer;
        const half = Math.floor(size / 2);
        const out = new Array(buffer.length);
        for (let i = 0; i < buffer.length; i++) {
            const window = [];
            for (let k = i - half; k <= i + half; k++) {
                if (k >= 0 && k < buffer.length) window.push(buffer[k]);
            }
            window.sort((a, b) => a - b);
            out[i] = window[Math.floor(window.length / 2)];
        }
        return out;
    }

    function drawSpline(buffer, w, h) {
        const n = buffer.length;
        if (n < 2) return;
        const toPoint = (i) => ({
            x: (i / (scopeMax - 1)) * w,
            y: h - (buffer[i] / 4095) * h,
        });

        const alpha = 0.5; // Catmull-Rom
        const get = (i) => buffer[Math.max(0, Math.min(n - 1, i))];

        let p0 = toPoint(0);
        scopeCtx.moveTo(p0.x, p0.y);
        for (let i = 0; i < n - 1; i++) {
            const p1 = toPoint(i);
            const p2 = toPoint(i + 1);
            const p3 = toPoint(Math.min(i + 2, n - 1));

            const t1x = (p2.x - p0.x) * alpha;
            const t1y = (p2.y - p0.y) * alpha;
            const t2x = (p3.x - p1.x) * alpha;
            const t2y = (p3.y - p1.y) * alpha;

            const cp1x = p1.x + t1x / 3;
            const cp1y = p1.y + t1y / 3;
            const cp2x = p2.x - t2x / 3;
            const cp2y = p2.y - t2y / 3;

            scopeCtx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, p2.x, p2.y);
            p0 = p1;
        }
    }

    async function fetchWeather() {
        const city = weatherCityEl.value.trim();
        let lat = weatherLatEl.value.trim();
        let lon = weatherLonEl.value.trim();

        setWeatherMsg("查询中...");

        try {
            if ((!lat || !lon) && city) {
                const geoRes = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(city)}&count=1&language=zh&format=json`);
                const geoData = await geoRes.json();
                const item = geoData?.results?.[0];
                if (!item) {
                    setWeatherMsg("未找到城市，请手动输入经纬度");
                    return;
                }
                lat = String(item.latitude);
                lon = String(item.longitude);
                weatherLatEl.value = lat;
                weatherLonEl.value = lon;
                weatherPlaceEl.textContent = `${item.name}${item.country ? ", " + item.country : ""}`;
            } else if (city) {
                weatherPlaceEl.textContent = city;
            } else if (lat && lon) {
                weatherPlaceEl.textContent = `${lat}, ${lon}`;
            }

            if (!lat || !lon) {
                setWeatherMsg("请填写城市或经纬度");
                return;
            }

            const url = `https://api.open-meteo.com/v1/forecast?latitude=${encodeURIComponent(lat)}&longitude=${encodeURIComponent(lon)}&current=temperature_2m,wind_speed_10m,weather_code`;
            const res = await fetch(url);
            const data = await res.json();
            const current = data?.current;
            if (!current) {
                setWeatherMsg("天气数据获取失败");
                return;
            }

            const temp = current.temperature_2m;
            const wind = current.wind_speed_10m;
            const code = current.weather_code;

            weatherTempEl.textContent = typeof temp === "number" ? temp.toFixed(1) : "--";
            weatherWindEl.textContent = typeof wind === "number" ? wind.toFixed(1) : "--";
            weatherCodeEl.textContent = typeof code === "number" ? String(code) : "--";

            latestWeather = {
                temp,
                wind,
                code,
                lat: Number(lat),
                lon: Number(lon),
                place: weatherPlaceEl.textContent || city || `${lat},${lon}`,
            };

            setWeatherMsg("已更新");
        } catch (err) {
            setWeatherMsg("查询失败：" + err);
        }
    }

    async function sendWeatherToEsp32() {
        if (!latestWeather) {
            setWeatherMsg("请先查询天气");
            return;
        }
        const { temp, wind, code, place } = latestWeather;
        const url = buildUrl(`/weather?temp=${encodeURIComponent(temp)}&wind=${encodeURIComponent(wind)}&code=${encodeURIComponent(code)}&place=${encodeURIComponent(place)}`);
        if (!url) {
            setWeatherMsg("请先填写 ESP32 地址");
            return;
        }
        setWeatherMsg("发送中...");
        try {
            const res = await fetch(url, { method: "GET" });
            const text = await res.text();
            setWeatherMsg(`已发送：${res.status} | ${text}`);
        } catch (err) {
            setWeatherMsg("发送失败：" + err);
        }
    }

    async function request(path) {
        const url = buildUrl(path);
        if (!url) {
            setMsg("请先填写 ESP32 地址");
            return;
        }
        setMsg("请求中...");
        try {
            const res = await fetch(url, { method: "GET" });
            const text = await res.text();
            const maybeJson = text.trim().startsWith("{") ? JSON.parse(text) : null;
            if (maybeJson) updateCards(maybeJson);
            setMsg(`状态码: ${res.status}${maybeJson ? "" : ` | ${text}`}`);
        } catch (err) {
            setMsg("请求失败：" + err);
        }
    }

    document.getElementById("esp32-status").addEventListener("click", () => request("/status"));
    document.getElementById("esp32-toggle").addEventListener("click", () => request("/toggle"));
    document.getElementById("esp32-adc").addEventListener("click", () => request("/adc"));
    document.getElementById("weather-fetch").addEventListener("click", fetchWeather);
    document.getElementById("weather-send").addEventListener("click", sendWeatherToEsp32);

    let pollTimer = null;
    function startPolling() {
        if (!pollEnabledEl.checked) return;
        const interval = Math.max(500, Number(pollIntervalEl.value) || 2000);
        if (pollTimer) clearInterval(pollTimer);
        pollTimer = setInterval(() => request("/status"), interval);
    }

    function stopPolling() {
        if (pollTimer) clearInterval(pollTimer);
        pollTimer = null;
    }

    function applySettings() {
        stopPolling();
        if (pollEnabledEl.checked) {
            startPolling();
        } else {
            setMsg("轮询已关闭");
        }
    }

    async function sendConfig() {
        const url = buildUrl(`/config?led_pin=${encodeURIComponent(ledPinEl.value)}&adc_pin=${encodeURIComponent(adcPinEl.value)}`);
        if (!url) {
            setMsg("请先填写 ESP32 地址");
            return;
        }
        setMsg("发送配置中...");
        try {
            const res = await fetch(url, { method: "GET" });
            const text = await res.text();
            setMsg(`配置结果: ${res.status} | ${text}`);
        } catch (err) {
            setMsg("配置失败：" + err);
        }
    }

    function saveSettings() {
        const payload = {
            pollEnabled: pollEnabledEl.checked,
            pollInterval: Number(pollIntervalEl.value) || 2000,
            ledPin: Number(ledPinEl.value) || 2,
            adcPin: Number(adcPinEl.value) || 34,
        };
        localStorage.setItem("esp32_panel_settings", JSON.stringify(payload));
        setMsg("已保存到本地");
    }

    function loadSettings() {
        try {
            const raw = localStorage.getItem("esp32_panel_settings");
            if (!raw) return;
            const data = JSON.parse(raw);
            if (typeof data.pollEnabled === "boolean") pollEnabledEl.checked = data.pollEnabled;
            if (typeof data.pollInterval === "number") pollIntervalEl.value = String(data.pollInterval);
            if (typeof data.ledPin === "number") ledPinEl.value = String(data.ledPin);
            if (typeof data.adcPin === "number") adcPinEl.value = String(data.adcPin);
        } catch {
            // ignore
        }
    }

    loadSettings();
    applySettings();

    resizeCanvas();
    window.addEventListener("resize", resizeCanvas);

    let scopeTimer = null;
    let scopeRunning = true;

    function startScope() {
        stopScope();
        const interval = Math.max(100, Number(scopeIntervalEl.value) || 300);
        const source = scopeSourceEl.value;
        scopeTimer = setInterval(() => request(source === "adc" ? "/adc" : "/status"), interval);
        scopeRunning = true;
        scopeCaptureEnabled = true;
        scopeToggleBtn.textContent = "暂停";
    }

    function stopScope() {
        if (scopeTimer) clearInterval(scopeTimer);
        scopeTimer = null;
        scopeRunning = false;
        scopeCaptureEnabled = false;
        scopeToggleBtn.textContent = "开始";
    }

    scopeToggleBtn.addEventListener("click", () => {
        if (scopeRunning) stopScope();
        else startScope();
    });

    scopeClearBtn.addEventListener("click", () => {
        scopeBuffer.length = 0;
        drawScope();
    });

    scopeSourceEl.addEventListener("change", () => {
        if (scopeRunning) startScope();
    });

    scopeIntervalEl.addEventListener("change", () => {
        if (scopeRunning) startScope();
    });

    scopeSmoothEl.addEventListener("change", drawScope);
    scopeFitEl.addEventListener("change", drawScope);

    startScope();

    document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
            stopPolling();
            stopScope();
        } else {
            applySettings();
            if (scopeRunning) startScope();
        }
    });

    pollEnabledEl.addEventListener("change", applySettings);
    pollIntervalEl.addEventListener("change", applySettings);
    document.getElementById("apply-settings").addEventListener("click", () => {
        applySettings();
        sendConfig();
    });
    document.getElementById("save-settings").addEventListener("click", saveSettings);
</script>